{
  "version": "2.0",
  "design_philosophy": "每个tool是原子物理操作：明确的requires→provides，粒度统一，可通过DFS反向链式搜索拼接成完整推导链",
  "physical_quantity_ontology": {
    "_comment": "物理量层次树，用于匹配时的层次推理",
    "nuclear_structure": {
      "mass_number_A": {"type": "integer", "unit": null},
      "charge_number_Z": {"type": "integer", "unit": null},
      "neutron_number_N": {"type": "integer", "unit": null},
      "nuclear_radius": {"type": "scalar", "unit": "fm", "children": ["charge_radius", "matter_radius", "half_density_radius"]},
      "deformation_parameter": {"type": "scalar", "unit": null, "children": ["beta2", "beta4"]},
      "spin_parity": {"type": "label", "unit": null},
      "nucleon_density": {"type": "function_of_r", "unit": "fm^-3", "children": ["proton_density", "neutron_density", "matter_density"]},
      "binding_energy": {"type": "scalar", "unit": "MeV", "children": ["total_binding_energy", "separation_energy", "shell_correction_energy", "pairing_energy"]},
      "single_particle_levels": {"type": "spectrum", "unit": "MeV"}
    },
    "decay_quantities": {
      "Q_value": {"type": "scalar", "unit": "MeV"},
      "penetrability": {"type": "scalar", "unit": null, "range": "[0,1]"},
      "preformation_factor": {"type": "scalar", "unit": null, "range": "[0,1]"},
      "assault_frequency": {"type": "scalar", "unit": "s^-1"},
      "decay_width": {"type": "scalar", "unit": "MeV"},
      "alpha_decay_width": {"type": "scalar", "unit": "MeV", "parent": "decay_width"},
      "transition_width": {"type": "scalar", "unit": "MeV", "parent": "decay_width"},
      "decay_constant": {"type": "scalar", "unit": "s^-1"},
      "activity": {"type": "scalar", "unit": "Bq"},
      "remaining_fraction": {"type": "scalar", "unit": null, "range": "[0,1]"},
      "equilibrium_abundance_ratio": {"type": "scalar", "unit": null},
      "time_dependent_abundance": {"type": "function_of_t", "unit": null},
      "kinetic_energy_products": {"type": "scalar_or_vector", "unit": "MeV"},
      "reaction_rate": {"type": "scalar", "unit": "s^-1"},
      "particle_flux": {"type": "scalar", "unit": "cm^-2 s^-1"},
      "coulomb_barrier_height": {"type": "scalar", "unit": "MeV"},
      "incident_energy": {"type": "scalar", "unit": "MeV"},
      "momentum_transfer": {"type": "scalar", "unit": "MeV/c"},
      "outgoing_energy": {"type": "scalar", "unit": "MeV"},
      "scattered_photon_energy": {"type": "scalar", "unit": "MeV"},
      "recoil_electron_energy": {"type": "scalar", "unit": "MeV"},
      "differential_cross_section": {"type": "function_of_angle", "unit": "mb/sr"},
      "stopping_power": {"type": "function_of_energy", "unit": "MeV/(g/cm^2)"},
      "form_factor": {"type": "function_of_q2", "unit": null, "range": "[0,1]"},
      "charge_radius": {"type": "scalar", "unit": "fm"},
      "half_life": {"type": "scalar", "unit": "s"},
      "decay_constant": {"type": "scalar", "unit": "s^-1"},
      "branching_ratio": {"type": "scalar", "unit": null}
    },
    "potential_quantities": {
      "nuclear_potential": {"type": "function_of_r", "unit": "MeV", "children": ["woods_saxon_potential", "folded_potential", "proximity_potential"]},
      "coulomb_potential": {"type": "function_of_r", "unit": "MeV"},
      "centrifugal_potential": {"type": "function_of_r", "unit": "MeV"},
      "effective_potential": {"type": "function_of_r", "unit": "MeV", "composition": "nuclear + coulomb + centrifugal"},
      "optical_potential": {"type": "complex_function_of_r", "unit": "MeV", "children": ["real_optical_potential", "imaginary_optical_potential", "spin_orbit_potential"]},
      "nucleon_nucleon_interaction": {"type": "function_of_r", "unit": "MeV", "children": ["m3y_interaction", "ddm3y_interaction", "reid_potential"]}
    },
    "scattering_quantities": {
      "cross_section": {"type": "function_of_angle_or_energy", "unit": "mb", "children": ["differential_cross_section", "total_cross_section", "reaction_cross_section", "elastic_cross_section"]},
      "scattering_amplitude": {"type": "complex_function", "unit": "fm"},
      "phase_shift": {"type": "scalar_per_l", "unit": "rad"},
      "S_matrix_element": {"type": "complex_scalar_per_l", "unit": null},
      "transmission_coefficient": {"type": "scalar_per_l", "unit": null, "range": "[0,1]"},
      "optical_model_parameters": {"type": "parameter_set", "unit": "mixed"}
    },
    "ml_quantities": {
      "training_dataset": {"type": "dataset", "unit": null},
      "feature_vector": {"type": "vector", "unit": "mixed"},
      "model_weights": {"type": "parameter_set", "unit": null},
      "prediction_output": {"type": "scalar_or_vector", "unit": "varies"},
      "loss_function_value": {"type": "scalar", "unit": null},
      "model_uncertainty": {"type": "scalar", "unit": null}
    },
    "mathematical_objects": {
      "wave_function": {"type": "function", "unit": "fm^-3/2", "children": ["single_particle_wavefunction", "cluster_wavefunction", "scattering_wavefunction"]},
      "single_particle_wavefunction": {"type": "function", "unit": "fm^-3/2", "parent": "wave_function"},
      "cluster_wavefunction": {"type": "function", "unit": "fm^-3/2", "parent": "wave_function"},
      "scattering_wavefunction": {"type": "function", "unit": "fm^-3/2", "parent": "wave_function"},
      "turning_points": {"type": "pair_of_scalars", "unit": "fm"},
      "action_integral": {"type": "scalar", "unit": null},
      "matrix_element": {"type": "scalar_or_complex", "unit": "varies"},
      "chi_squared": {"type": "scalar", "unit": null},
      "fitted_parameters": {"type": "parameter_set", "unit": "mixed"}
    }
  },
  "tools": [

    {"_section": "=== A. 核结构输入层 (Nuclear Structure Input) ==="},

    {
      "id": "T01",
      "tool_name": "nuclear_radius_estimation",
      "description": "从质量数A估算核半径 R = r0 * A^(1/3)",
      "requires": ["mass_number_A"],
      "provides": ["nuclear_radius"],
      "constraints": {},
      "category": "nuclear_structure"
    },
    {
      "id": "T02",
      "tool_name": "shell_model_filling",
      "description": "根据Z,N填充壳模型能级，确定基态自旋宇称和价核子轨道",
      "requires": ["charge_number_Z", "neutron_number_N"],
      "provides": ["spin_parity", "single_particle_levels"],
      "constraints": {"symmetry": "spherical_or_weak_deformation"},
      "category": "nuclear_structure"
    },
    {
      "id": "T03",
      "tool_name": "bethe_weizsacker_mass_formula",
      "description": "半经验质量公式计算结合能（体积+表面+库仑+对称+配对项）",
      "requires": ["mass_number_A", "charge_number_Z"],
      "provides": ["binding_energy", "pairing_energy"],
      "constraints": {"regime": "empirical", "validity": "A > 12"},
      "category": "nuclear_structure"
    },
    {
      "id": "T04",
      "tool_name": "Q_value_calculation",
      "description": "从母核与子核结合能之差计算衰变Q值",
      "requires": ["binding_energy"],
      "provides": ["Q_value"],
      "constraints": {},
      "category": "decay"
    },
    {
      "id": "T05",
      "tool_name": "mean_field_density_calculation",
      "description": "用平均场方法(RMF/HF/HFB)自洽求解核子密度分布",
      "requires": ["mass_number_A", "charge_number_Z"],
      "provides": ["nucleon_density", "single_particle_levels", "binding_energy"],
      "constraints": {"method": "first_principles", "compute_cost": "high"},
      "category": "nuclear_structure"
    },
    {
      "id": "T06",
      "tool_name": "deformation_parameter_extraction",
      "description": "从实验数据或理论计算提取核形变参数beta2/beta4",
      "requires": ["mass_number_A", "charge_number_Z"],
      "provides": ["deformation_parameter"],
      "constraints": {},
      "category": "nuclear_structure"
    },
    {
      "id": "T07",
      "tool_name": "pairing_correlation_BCS",
      "description": "BCS方法处理核子配对关联，计算配对能和准粒子谱",
      "requires": ["single_particle_levels"],
      "provides": ["pairing_energy", "single_particle_wavefunction"],
      "constraints": {"regime": "first_principles"},
      "category": "nuclear_structure"
    },

    {"_section": "=== B. 势能构建层 (Potential Construction) ==="},

    {
      "id": "T08",
      "tool_name": "woods_saxon_parameterization",
      "description": "用Woods-Saxon形式参数化核势（深度V0, 半径R, 弥散a）",
      "requires": ["nuclear_radius", "mass_number_A"],
      "provides": ["nuclear_potential"],
      "constraints": {"form": "phenomenological"},
      "category": "potential"
    },
    {
      "id": "T09",
      "tool_name": "double_folding_integral",
      "description": "将核子密度与NN有效相互作用做空间折叠积分，得到微观核势",
      "requires": ["nucleon_density", "nucleon_nucleon_interaction"],
      "provides": ["nuclear_potential"],
      "constraints": {"method": "microscopic", "requires_density": true},
      "category": "potential"
    },
    {
      "id": "T10",
      "tool_name": "NN_effective_interaction",
      "description": "选择或构建核子-核子有效相互作用(M3Y/DDM3Y/Reid等)",
      "requires": ["nucleon_density", "single_particle_levels"],
      "provides": ["nucleon_nucleon_interaction"],
      "constraints": {},
      "category": "potential"
    },
    {
      "id": "T11",
      "tool_name": "coulomb_potential_calculation",
      "description": "计算均匀带电球或点电荷的库仑势",
      "requires": ["charge_number_Z", "nuclear_radius"],
      "provides": ["coulomb_potential"],
      "constraints": {},
      "category": "potential"
    },
    {
      "id": "T12",
      "tool_name": "centrifugal_potential_construction",
      "description": "构建离心势 l(l+1)hbar^2/(2mu*r^2)",
      "requires": ["spin_parity"],
      "provides": ["centrifugal_potential"],
      "constraints": {},
      "category": "potential"
    },
    {
      "id": "T13",
      "tool_name": "effective_potential_assembly",
      "description": "将核势+库仑势+离心势叠加为总有效势",
      "requires": ["nuclear_potential", "coulomb_potential", "centrifugal_potential"],
      "provides": ["effective_potential"],
      "constraints": {},
      "category": "potential"
    },
    {
      "id": "T14",
      "tool_name": "proximity_potential_calculation",
      "description": "用邻近势公式计算两核表面间的核力势",
      "requires": ["nuclear_radius", "mass_number_A", "charge_number_Z"],
      "provides": ["nuclear_potential"],
      "constraints": {"regime": "surface_interaction", "validity": "heavy_systems"},
      "category": "potential"
    },
    {
      "id": "T15",
      "tool_name": "liquid_drop_potential",
      "description": "液滴模型构建形变依赖的势能面(GLDM等)",
      "requires": ["mass_number_A", "charge_number_Z", "deformation_parameter"],
      "provides": ["effective_potential"],
      "constraints": {"regime": "macroscopic"},
      "category": "potential"
    },
    {
      "id": "T16",
      "tool_name": "optical_potential_construction",
      "description": "构建光学模型势（实部+虚部+自旋轨道项）",
      "requires": ["nuclear_potential", "mass_number_A", "charge_number_Z"],
      "provides": ["optical_potential"],
      "constraints": {"domain": "scattering"},
      "category": "potential"
    },
    {
      "id": "T17",
      "tool_name": "deformation_potential_correction",
      "description": "对球形势做形变修正（耦合通道或形变平均）",
      "requires": ["nuclear_potential", "deformation_parameter"],
      "provides": ["nuclear_potential"],
      "constraints": {"applies_when": "deformed_nucleus"},
      "category": "potential"
    },

    {"_section": "=== C. 隧穿与衰变计算层 (Tunneling & Decay) ==="},

    {
      "id": "T18",
      "tool_name": "turning_point_solver",
      "description": "求解V_eff(r) = Q的经典转折点r1, r2, r3",
      "requires": ["effective_potential", "Q_value"],
      "provides": ["turning_points"],
      "constraints": {},
      "category": "tunneling"
    },
    {
      "id": "T19",
      "tool_name": "WKB_action_integral",
      "description": "在转折点间计算WKB作用量积分 G = (2/hbar) * integral[sqrt(2mu(V-Q))]dr",
      "requires": ["effective_potential", "turning_points", "Q_value"],
      "provides": ["action_integral"],
      "constraints": {"validity": "slowly_varying_potential", "method": "semiclassical"},
      "category": "tunneling"
    },
    {
      "id": "T20",
      "tool_name": "penetrability_from_action",
      "description": "从WKB作用量计算穿透概率 P = exp(-2*G) 或 Hill-Wheeler公式",
      "requires": ["action_integral"],
      "provides": ["penetrability"],
      "constraints": {},
      "category": "tunneling"
    },
    {
      "id": "T21",
      "tool_name": "preformation_factor_model",
      "description": "计算alpha粒子在母核内的预形成概率（团簇模型/经验公式）",
      "requires": ["mass_number_A", "charge_number_Z", "binding_energy"],
      "provides": ["preformation_factor"],
      "constraints": {},
      "category": "decay"
    },
    {
      "id": "T22",
      "tool_name": "assault_frequency_calculation",
      "description": "计算alpha粒子撞击势垒的频率 nu = v/(2R)",
      "requires": ["Q_value", "nuclear_radius"],
      "provides": ["assault_frequency"],
      "constraints": {},
      "category": "decay"
    },
    {
      "id": "T23",
      "tool_name": "decay_width_formula",
      "description": "从穿透概率、预形成因子、撞击频率计算衰变宽度 Gamma = hbar*nu*P*S",
      "requires": ["penetrability", "preformation_factor", "assault_frequency"],
      "provides": ["alpha_decay_width"],
      "constraints": {},
      "category": "decay"
    },
    {
      "id": "T24",
      "tool_name": "halflife_from_width",
      "description": "从衰变宽度或衰变常数计算半衰期 T = hbar*ln2/Gamma",
      "requires": ["alpha_decay_width"],
      "provides": ["half_life"],
      "constraints": {},
      "category": "decay"
    },
    {
      "id": "T25",
      "tool_name": "empirical_halflife_formula",
      "description": "经验半衰期公式(Viola-Seaborg/Geiger-Nuttall/Royer等)直接估算",
      "requires": ["Q_value", "mass_number_A", "charge_number_Z"],
      "provides": ["half_life"],
      "constraints": {"regime": "empirical", "accuracy": "order_of_magnitude"},
      "category": "decay"
    },
    {
      "id": "T26",
      "tool_name": "cluster_formation_probability",
      "description": "团簇模型计算alpha团簇形成概率（RGM/GCM/THSR波函数）",
      "requires": ["cluster_wavefunction", "mass_number_A"],
      "provides": ["preformation_factor"],
      "constraints": {"method": "microscopic_cluster"},
      "category": "decay"
    },
    {
      "id": "T27",
      "tool_name": "R_matrix_decay_width",
      "description": "R矩阵方法计算衰变宽度（约化宽度+穿透因子）",
      "requires": ["cluster_wavefunction", "nuclear_radius", "penetrability"],
      "provides": ["alpha_decay_width"],
      "constraints": {"method": "R_matrix"},
      "category": "decay"
    },

    {"_section": "=== D. 散射计算层 (Scattering) ==="},

    {
      "id": "T28",
      "tool_name": "schrodinger_equation_solver",
      "description": "数值求解径向薛定谔方程，得到散射波函数",
      "requires": ["optical_potential", "Q_value", "spin_parity"],
      "provides": ["scattering_wavefunction", "phase_shift"],
      "constraints": {"method": "numerical"},
      "category": "scattering"
    },
    {
      "id": "T29",
      "tool_name": "partial_wave_expansion",
      "description": "将散射振幅按分波展开，从相移计算散射振幅",
      "requires": ["phase_shift"],
      "provides": ["scattering_amplitude"],
      "constraints": {},
      "category": "scattering"
    },
    {
      "id": "T30",
      "tool_name": "cross_section_from_amplitude",
      "description": "从散射振幅计算微分截面和总截面",
      "requires": ["scattering_amplitude"],
      "provides": ["cross_section"],
      "constraints": {},
      "category": "scattering"
    },
    {
      "id": "T31",
      "tool_name": "optical_model_fitting",
      "description": "拟合光学势参数使理论截面最佳符合实验数据",
      "requires": ["cross_section", "optical_potential"],
      "provides": ["optical_model_parameters", "chi_squared"],
      "constraints": {"requires_experimental_data": true},
      "category": "scattering"
    },
    {
      "id": "T32",
      "tool_name": "reaction_cross_section_calculation",
      "description": "从S矩阵或透射系数计算反应截面",
      "requires": ["transmission_coefficient"],
      "provides": ["cross_section"],
      "constraints": {},
      "category": "scattering"
    },
    {
      "id": "T33",
      "tool_name": "transmission_coefficient_from_potential",
      "description": "从光学势计算各分波透射系数",
      "requires": ["optical_potential"],
      "provides": ["transmission_coefficient"],
      "constraints": {},
      "category": "scattering"
    },
    {
      "id": "T34",
      "tool_name": "folding_model_optical_potential",
      "description": "用折叠模型从基态密度构建微观光学势",
      "requires": ["nucleon_density", "nucleon_nucleon_interaction"],
      "provides": ["optical_potential"],
      "constraints": {"method": "microscopic"},
      "category": "scattering"
    },
    {
      "id": "T35",
      "tool_name": "dispersive_optical_model",
      "description": "色散光学模型：实部虚部通过色散关系自洽关联",
      "requires": ["optical_model_parameters"],
      "provides": ["optical_potential"],
      "constraints": {"method": "dispersive", "energy_range": "wide"},
      "category": "scattering"
    },

    {"_section": "=== E. 机器学习层 (Machine Learning Pipeline) ==="},

    {
      "id": "T36",
      "tool_name": "feature_engineering",
      "description": "从核结构量(Z,N,A,delta,pairing等)构建ML特征向量",
      "requires": ["mass_number_A", "charge_number_Z", "neutron_number_N"],
      "provides": ["feature_vector"],
      "constraints": {"domain": "ML"},
      "category": "ml"
    },
    {
      "id": "T37",
      "tool_name": "training_data_preparation",
      "description": "从实验数据库(AME/NUBASE/ENSDF)准备训练集",
      "requires": ["feature_vector"],
      "provides": ["training_dataset"],
      "constraints": {"domain": "ML", "requires_experimental_data": true},
      "category": "ml"
    },
    {
      "id": "T38",
      "tool_name": "neural_network_training",
      "description": "训练神经网络(MLP/BNN/CNN)学习核性质映射",
      "requires": ["training_dataset"],
      "provides": ["model_weights", "loss_function_value"],
      "constraints": {"domain": "ML"},
      "category": "ml"
    },
    {
      "id": "T39",
      "tool_name": "model_prediction",
      "description": "用训练好的模型预测新核素的性质(半衰期/结合能/截面等)",
      "requires": ["model_weights", "feature_vector"],
      "provides": ["prediction_output", "model_uncertainty"],
      "constraints": {"domain": "ML"},
      "category": "ml"
    },
    {
      "id": "T40",
      "tool_name": "cross_validation_evaluation",
      "description": "交叉验证评估模型泛化能力",
      "requires": ["model_weights", "training_dataset"],
      "provides": ["chi_squared", "model_uncertainty"],
      "constraints": {"domain": "ML"},
      "category": "ml"
    },
    {
      "id": "T41",
      "tool_name": "bayesian_uncertainty_quantification",
      "description": "贝叶斯方法量化预测不确定度",
      "requires": ["model_weights", "training_dataset"],
      "provides": ["model_uncertainty", "prediction_output"],
      "constraints": {"domain": "ML", "method": "bayesian"},
      "category": "ml"
    },

    {"_section": "=== F. 数学操作层 (Mathematical Operations) ==="},

    {
      "id": "T42",
      "tool_name": "numerical_integration",
      "description": "数值积分（高斯求积/Simpson/自适应）",
      "requires": ["effective_potential", "turning_points"],
      "provides": ["action_integral"],
      "constraints": {"method": "numerical"},
      "category": "math"
    },
    {
      "id": "T43",
      "tool_name": "eigenvalue_solver",
      "description": "求解本征值问题（束缚态能级、共振态）",
      "requires": ["effective_potential", "spin_parity"],
      "provides": ["single_particle_wavefunction", "single_particle_levels"],
      "constraints": {},
      "category": "math"
    },
    {
      "id": "T44",
      "tool_name": "chi_squared_minimization",
      "description": "最小二乘拟合，优化参数使chi^2最小",
      "requires": ["prediction_output"],
      "provides": ["fitted_parameters", "chi_squared"],
      "constraints": {"requires_experimental_data": true},
      "category": "math"
    },
    {
      "id": "T45",
      "tool_name": "matrix_element_calculation",
      "description": "计算算符在波函数间的矩阵元",
      "requires": ["cluster_wavefunction"],
      "provides": ["matrix_element"],
      "constraints": {},
      "category": "math"
    },

    {"_section": "=== G. 验证与比较层 (Verification) ==="},

    {
      "id": "T46",
      "tool_name": "experimental_comparison",
      "description": "将理论计算结果与实验数据对比，计算偏差",
      "requires": ["half_life"],
      "provides": ["chi_squared"],
      "constraints": {"requires_experimental_data": true},
      "category": "verification"
    },
    {
      "id": "T47",
      "tool_name": "systematic_trend_analysis",
      "description": "分析物理量随Z/N/A的系统学趋势",
      "requires": ["half_life", "mass_number_A"],
